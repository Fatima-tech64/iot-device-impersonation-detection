# Copy this file to .env and fill in local demo values. Do not commit .env.

# MQTT broker used by the simulated device
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# Simulated ESP32 identity, publishing interval (seconds), and telemetry topic
SIM_DEVICE_ID=IOT-001
SIM_DEVICE_TYPE=environment_sensor
SIM_PUBLISH_INTERVAL=5
MQTT_TOPIC_TEMPLATE=iot/devices/{device_id}/telemetry
# Safe synthetic impersonation simulator options
IMPSIM_SCENARIO=IMPERSONATION
IMPSIM_CLAIMED_DEVICE_ID=IOT-001
# Optional CUSTOM scenario values (uncomment and adjust as needed)
# IMPSIM_TEMPERATURE=37.5
# IMPSIM_HUMIDITY=88
# IMPSIM_MOTION=true
# IMPSIM_INTERVAL=2
# Security engine subscriber and local event log
MQTT_SUBSCRIBE_TOPIC=iot/devices/+/telemetry
DEVICE_REGISTRY_PATH=config/device_registry.json
SECURITY_EVENT_LOG=logs/security_events.jsonl
# Optional ThingsBoard Cloud integration (keeps local MQTT independent)
THINGSBOARD_ENABLED=false
THINGSBOARD_HOST=your-tenant.thingsboard.cloud
THINGSBOARD_PORT=8883
THINGSBOARD_ACCESS_TOKEN=replace_with_your_device_access_token
THINGSBOARD_USE_TLS=true
THINGSBOARD_TELEMETRY_TOPIC=v1/devices/me/telemetry
THINGSBOARD_QOS=1
THINGSBOARD_KEEPALIVE=60
